{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/documents-log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MmcDocumentsDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "PublicKey": "",
    "Issuer": "MedicalCenter.Auth",
    "Audience": "MedicalCenter.Clients",
    "ClockSkewSeconds": 30
  },
  "MinioSettings": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "medical-center-documents",
    "UseSsl": false
  },
  "PdfSettings": {
    "RegularFontPath": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "BoldFontPath": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "FontFamily": "DejaVu Sans",
    "ClinicName": "Медицинский центр"
  },
  "RabbitMqSettings": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "DocumentCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "MinimumAgeHours": 24,
    "RevalidateAfterDays": 7,
    "BatchSize": 200
  },
  "GrpcClients": {
    "Appointments": "http://localhost:8006",
    "Profiles": "http://localhost:8001"
  }
}
