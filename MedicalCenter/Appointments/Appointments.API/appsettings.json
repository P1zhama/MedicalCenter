{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/appointments-log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MmcAppointmentsDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "PublicKey": "",
    "Issuer": "MedicalCenter.Auth",
    "Audience": "MedicalCenter.Clients",
    "ClockSkewSeconds": 30
  },
  "WorkingHours": {
    "Start": "08:00",
    "End": "17:00",
    "BreakStart": "12:00",
    "BreakEnd": "13:00",
    "SlotMinutes": 10,
    "WorkingDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ],
    "BookingHorizonDays": 30
  },
  "RabbitMqSettings": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "GrpcClients": {
    "Profiles": "http://localhost:8001",
    "Services": "http://localhost:8002",
    "Offices": "http://localhost:8004"
  }
}
