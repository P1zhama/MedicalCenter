{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "documents-route": {
        "ClusterId": "documents-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Metadata": {
          "ResiliencePolicy": "DefaultStrategy"
        }
      }
    },
    "Clusters": {
      "documents-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:8008" },
          "destination2": { "Address": "https://localhost:8009" }
        }
      }
    }
  }
}
