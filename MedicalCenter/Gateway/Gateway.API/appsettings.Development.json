{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "documents-route": {
        "ClusterId": "documents-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "documents-cluster": {
        "Destinations": {
          "documents": { "Address": "http://localhost:8008" }
        }
      }
    }
  }
}
