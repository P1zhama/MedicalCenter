{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway-log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "GrpcClients": {
    "Authorization": "http://localhost:8000",
    "Profiles": "http://localhost:8001",
    "Offices": "http://localhost:8004",
    "Services": "http://localhost:8002",
    "Appointments": "http://localhost:8006"
  },
  "ReverseProxy": {
    "Routes": {
      "documents-route": {
        "ClusterId": "documents-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Metadata": {
          "ResiliencePolicy": "DefaultStrategy"
        }
      }
    },
    "Clusters": {
      "documents-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:8008" },
          "destination2": { "Address": "https://localhost:8009" }
        }
      }
    }
  }
}